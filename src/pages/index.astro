---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Jumbotron from '../components/Jumbotron.astro';
import DefaultLayoutContent from '../components/DefaultLayoutContent.astro';
---

<DefaultLayout title="Home">
  <Navbar />
  <Jumbotron />
  <DefaultLayoutContent>
    <div class="col-md-4">
      <h2>Gift Certificates</h2>
      <p>Young and old will enjoy the gift of flight with a gift certificate. </p>
      <a class="btn btn-primary" href="/gift-certificates/">Get yours now</a>
    </div>
    <div class="col-md-4">
      <h2>Training</h2>
      <p>Safe and comprehensive ultralight trike training.</p>
      <a class="btn btn-primary" href="/training/">Book lessons</a>
    </div>
    <div class="col-md-4">
      <h2>Sales</h2>
      <p>Used and new aircraft and equipment available for purchase.</p>
      <a class="btn btn-primary" href="/sales/">View listings</a>
    </div>
  </DefaultLayoutContent>
  <hr />
  <Footer />
</DefaultLayout>
